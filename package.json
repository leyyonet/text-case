{
  "name": "@leyyo/text-case",
  "version": "1.1.1",
  "description": "Converts different naming conventions",
  "keywords": [
    "camelCase",
    "PascalCase",
    "snake_case",
    "under_score",
    "kebab-case",
    "dash-case",
    "UPPER_CASE",
    "ALL_CAPS",
    "Header Case",
    "Title Case",
    "Label Case",
    "Sentence case",
    "regular case",
    "camelize",
    "decamelize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leyyonet/text-case.git"
  },
  "bugs": {
    "email": "mustafayelmer@gmail.com",
    "url": "https://github.com/leyyonet/text-case/issues"
  },
  "homepage": "https://github.com/leyyonet/text-case#readme",
  "author": {
    "name": "Mustafa Yelmer",
    "email": "mustafayelmer@gmail.com"
  },
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "clear": "rimraf dist && rimraf coverage",
    "lint": "eslint src/**/*.ts",
    "asset": "node -r ts-node/register commands/assets.ts",
    "build": "npm run clear && tsc && npm run asset",
    "test": "jest --config=jest.json --detectOpenHandles",
    "test:watch": "jest --watch --config=jest.json",
    "test:coverage": "rimraf coverage && jest --config=jest.json --coverage --coverageDirectory=coverage",
    "ts": "node -r ts-node/register src/sample.ts",
    "~publish": "npmaaa run build && npm publish -access=public"
  },
  "files": [
    "dist/*"
  ],
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.28.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.7.1",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "test": "^3.3.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "dependencies": {
    "@leyyo/cast": "file:../cast",
    "@leyyo/common": "file:../common",
    "@leyyo/core": "file:../core",
    "@leyyo/error-enveloper": "^1.0.2",
    "@leyyo/http-call": "file:../http-call",
    "@leyyo/injection": "file:../injection",
    "@leyyo/pipe": "file:../pipe",
    "@leyyo/validator": "file:../validator"
  }
}
